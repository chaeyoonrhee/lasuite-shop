# 카카오 개발자센터(https://developers.kakaopay.com)에서 앱 생성 후 발급받은 값을 입력하세요.
# 테스트 단계에서는 CID를 TC0ONETIME으로 두고, "Secret Key(dev)"만 발급받아 넣으면 바로 결제 플로우를 테스트할 수 있습니다.
KAKAOPAY_CID=TC0ONETIME
KAKAOPAY_SECRET_KEY=

# 로컬 테스트 시 그대로 두면 됩니다. 배포 후에는 실제 접속 도메인으로 바꿔주세요.
BASE_URL=http://localhost:5000
PORT=5000

# 관리자 페이지(/admin) 로그인 비밀번호
ADMIN_PASSWORD=

# 주문 내역을 영구 저장할 GitHub 저장소 (repo 권한을 가진 Personal Access Token 필요)
GITHUB_TOKEN=
GITHUB_REPO=chaeyoonrhee/lasuite-shop
GITHUB_ORDERS_PATH=orders/orders.json

# Flask 세션 암호화 키 (임의의 긴 문자열)
FLASK_SECRET_KEY=

# 새 주문 알림을 받을 텔레그램 봇 (선택사항, 비워두면 알림 없이 정상 작동)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
